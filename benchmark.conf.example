# MySQL Standard vs Advanced Edition — benchmark configuration
# Copy to benchmark.conf and fill in your credentials:
#   cp benchmark.conf.example benchmark.conf

# --- Standard Edition (DigitalOcean Managed MySQL) ---
STANDARD_MYSQL_HOST=your-standard-cluster.db.ondigitalocean.com
STANDARD_MYSQL_PORT=25060
STANDARD_MYSQL_USER=doadmin
STANDARD_MYSQL_PASSWORD=CHANGE_ME
STANDARD_MYSQL_DB=benchmark

# --- Advanced Edition (DigitalOcean Managed MySQL) ---
ADVANCED_MYSQL_HOST=your-advanced-cluster.db.ondigitalocean.com
ADVANCED_MYSQL_PORT=25060
ADVANCED_MYSQL_USER=doadmin
ADVANCED_MYSQL_PASSWORD=CHANGE_ME
ADVANCED_MYSQL_DB=benchmark

# --- TPC-C dataset (identical on both editions for fair comparison) ---
TPCC_TABLES=10
TPCC_SCALE=100
TPCC_FORCE_PK=1
TPCC_TRX_LEVEL=RR
# Optional: comma-separated warehouse IDs to skip during TPC-C *run* sampling
# (incomplete holes). Clear / unset when the dataset is fully loaded.
# Requires bootstrap/patch_tpcc_skip_warehouses.sh applied to tpcc_run.lua.
# TPCC_SKIP_WAREHOUSE_IDS=977,978,979,980,988,1023,1271,1953,2210

# --- Test matrix ---
# Thread counts (space-separated)
THREADS="8 16 32 64"
# Run durations in seconds: 600=10m, 1200=20m
DURATIONS="600 1200"
WARMUP_SEC=60
PREP_THREADS=16
TPCC_REPORT_INTERVAL=10

# --- Behavior ---
# Editions to run: "standard advanced" or just one
EDITIONS="standard advanced"
# Drop TPC-C tables after all runs (0=keep, 1=cleanup)
CLEANUP_AFTER=0
# Skip prepare if tables already exist (0=always prepare, 1=skip)
SKIP_PREPARE=0

# --- MySQL server settings audit (fair comparison) ---
# Run settings comparison before benchmark (1=yes, 0=skip)
MYSQL_SETTINGS_CHECK=1
# Fail benchmark if Standard and Advanced settings differ (0=warn only, 1=abort)
MYSQL_FAIL_ON_SETTINGS_MISMATCH=0
# Variables to capture from both clusters (space-separated)
# Align these in DigitalOcean cluster settings before benchmarking.
MYSQL_VARS="version version_comment innodb_buffer_pool_size innodb_buffer_pool_instances innodb_log_file_size innodb_redo_log_capacity innodb_flush_log_at_trx_commit innodb_io_capacity innodb_io_capacity_max innodb_read_io_threads innodb_write_io_threads replica_parallel_workers group_replication_flow_control_certifier_threshold group_replication_flow_control_applier_threshold max_connections sql_require_primary_key transaction_isolation binlog_format sync_binlog character_set_server collation_server"
# Runtime metadata (buffer pool hit %, BP/data ratio) captured automatically before
# failover/prepare runs into mysql_runtime.env and merged into benchmark_config.env.
# Optional: document your intended cluster config (informational — set in DO control panel)
# MYSQL_CLUSTER_PLAN="db-s-4vcpu-8gb"

# Cluster sizing (failover HTML run metadata; edition-specific overrides below)
SLUG_SIZE=db-s-4vcpu-8gb
NUM_NODES=3
STANDARD_CLUSTER_SIZE_SLUG=db-s-4vcpu-8gb
STANDARD_CLUSTER_NUM_NODES=3
ADVANCED_CLUSTER_SIZE_SLUG=mysql-g-8vcpu-32gb
ADVANCED_CLUSTER_NUM_NODES=3
# MYSQL_NOTES="Buffer pool and CPU/RAM must match between Standard and Advanced clusters"

# --- Failover benchmark ---
# Editions to run: "standard advanced" or one edition
FAILOVER_EDITIONS="standard advanced"

# TPC-C load during failover test
# FAILOVER_THREADS=16
# Timeline (elapsed sec from sysbench start; trigger = warmup + baseline):
# FAILOVER_WARMUP_SEC=0            # optional warmup before baseline
# FAILOVER_BASELINE_SEC=300        # steady load before failover trigger
# FAILOVER_OBSERVE_SEC=300         # keep load running after trigger (harness also sleeps this long)
# FAILOVER_TRIGGER_SECOND=         # optional override; default warmup + baseline (= 300 with defaults above)
# Per scenario wall clock: warmup + baseline + observe (600s with defaults above)
# FAILOVER_REPORT_INTERVAL=1       # 1-second granularity (required for RTO + graphs)
# FAILOVER_PRIMARY_MONITOR_INTERVAL=0.25  # VIP/client-path poll (primary_monitor.tsv); sub-second for promote KPI
# FAILOVER_CLUSTER_MONITOR_INTERVAL=1     # GR pod + K8s pod monitors (kubectl); keep >= 1s
# FAILOVER_MONITOR_INTERVAL=1      # legacy fallback when the split intervals above are unset
# FAILOVER_MONITOR_CONNECT_TIMEOUT=1  # mysql --connect-timeout per monitor poll
# FAILOVER_MONITOR_OP_TIMEOUT=1    # max seconds per mysql session (timeout(1); one session = write + topology)
# FAILOVER_MONITOR_WRITE_PROBE=1   # INSERT write probe in same mysql session as topology SELECT
# FAILOVER_GENERATE_GRAPHS=1       # PNG + interactive HTML (HTML needs no extra deps; PNG needs matplotlib)
# FAILOVER_MONITOR_PRIMARY=1       # poll @@hostname, read_only, GR state/role, write probe
# FAILOVER_GR_POD_MONITOR=1        # Advanced: poll GR role/state/queues on each mysql pod via kubectl exec
# FAILOVER_K8S_POD_MONITOR=1       # Advanced: poll mysql-* pod phase/readiness via kubectl
# FAILOVER_HAPROXY_STATS_MONITOR=1 # Advanced: poll HAProxy stats socket (mysql-primary UP) on each haproxy pod
# FAILOVER_HAPROXY_STATS_MONITOR_INTERVAL=0.5  # seconds between stats polls (0.5 recommended)
# FAILOVER_GR_READINESS_GATE=1     # Block trigger until GR + mysql pods are fully healthy
# FAILOVER_GR_EXPECTED_MEMBERS=3   # Require this many ONLINE GR members (0 = do not enforce count)
# FAILOVER_GR_REQUIRE_K8S_PODS_READY=1  # Also require that many mysql-* pods Ready (not deleting)
# FAILOVER_GR_READINESS_POLL_SEC=2
# FAILOVER_GR_READINESS_TIMEOUT_SEC=600
# FAILOVER_GR_READINESS_ABORT_ON_TIMEOUT=1   # 0 = warn and trigger anyway on timeout
# FAILOVER_REPLICA_WORKERS_GATE=1            # Before each iteration: SET PERSIST replica_parallel_workers on all pods
# FAILOVER_REPLICA_PARALLEL_WORKERS=16       # Target value (operator default after pod recreate is 4)
# FAILOVER_REPLICA_WORKERS_POLL_SEC=2
# FAILOVER_REPLICA_WORKERS_TIMEOUT_SEC=600
# FAILOVER_REPLICA_WORKERS_ABORT_ON_TIMEOUT=1
# FAILOVER_COLLECT_K8S_EVENTS=1    # kubectl event snapshots (Advanced only)
# FAILOVER_RUN_TPCC_CHECK=0        # 1 = TPC-C check after failover (sets data_loss in failover_kpi.csv)
#
# TPC-C scenarios (trx_profile mapping):
# FAILOVER_SCENARIOS="read_heavy"           # default: 90% read / 10% write
# FAILOVER_SCENARIOS="mixed write_only"     # classic TPC-C mix, then write-only
# FAILOVER_SCENARIO_DELAY_SEC=120         # pause between scenarios (cooldown / cluster settle)
# FAILOVER_THREAD_MATRIX="4 8 16 32"      # run failover at each thread count (results under edition/t<N>/)
# FAILOVER_THREAD_DELAY_SEC=120             # pause between thread counts in a matrix run
# Unplanned + planned in one harness run (advanced only):
# FAILOVER_TRIGGER_MATRIX="pod_delete set_as_primary"
# FAILOVER_TRIGGER_MATRIX_DELAY_SEC=180     # settle between trigger methods (GR readiness also re-checked)
# FAILOVER_ITERATIONS=1                     # repeat full scenario loop N times (results under edition/iter<N>/)
# FAILOVER_ITERATION_START=1                # resume: first iteration number (use with FAILOVER_RESULTS_RESUME)
# FAILOVER_RESULTS_RESUME=                  # resume into existing results/failover_* dir (combined report at end)
# FAILOVER_ITERATION_DELAY_SEC=120          # soft cooldown between iters; readiness gate waits for full health
# FAILOVER_GR_READINESS_TIMEOUT_SEC=1800    # increase for 5TB GR rejoin after pod delete (default 600)
# Warm secondary InnoDB BPs via HAProxy replica/read port (read_only_fat = 100% SELECTs):
# FAILOVER_SECONDARY_WARMUP=1               # 0=off; 1=warm secondaries before run + during iter delay
# FAILOVER_SECONDARY_WARMUP_BEFORE_RUN=1    # once before first iteration
# FAILOVER_SECONDARY_WARMUP_DURING_DELAY=1  # replace idle sleep with :3307 read load
# FAILOVER_SECONDARY_WARMUP_PORT=3307       # HAProxy replica/read pool
# FAILOVER_SECONDARY_WARMUP_HOST=           # default = ADVANCED_MYSQL_HOST / MYSQL_HOST
# FAILOVER_SECONDARY_WARMUP_SEC=300         # pre-run warmup duration
# FAILOVER_SECONDARY_WARMUP_THREADS=        # default = FAILOVER_THREADS
# FAILOVER_SECONDARY_WARMUP_FAT_ROWS=       # default = TPCC_FAT_READ_ROWS
# TPC-C trx_profile (tpcc.lua):
#   read_heavy     — 90% orderstatus/stocklevel + 10% new_order/payment (tiny payloads)
#   read_heavy_fat — 90% fat_stock_scan + 10% new_order/payment (tens of KB/trx; for ~20MB/s)
#   read_only_fat  — 100% fat_stock_scan (secondary BP warmup on :3307)
#   mixed          — standard TPC-C mix
#   write_only     — 50/50 new_order/payment
# TPCC_FAT_READ_ROWS=150              # rows per fat_stock_scan (~250-300 bytes/row on wire)
# FAILOVER_SCENARIOS="read_heavy_fat" # use fat reads for network throughput targets
#
# Output layouts (any combination of the optional nest levels):
#   results/failover_*/advanced/<scenario>/
#   results/failover_*/advanced/t<N>/<scenario>/
#   results/failover_*/advanced/pod_delete/<scenario>/   # when FAILOVER_TRIGGER_MATRIX is set
#   results/failover_*/advanced/iter<N>/set_as_primary/t<N>/<scenario>/
# Combined HTML (thread toggle): results/failover_*/advanced/graphs/failover_report.html
#   read_heavy/     — 90% read / 10% write (tiny orderstatus/stocklevel)
#   read_heavy_fat/ — 90% fat stock range scans (large result sets)
#   mixed/          — standard TPC-C transaction mix (reads + writes)
#   write_only/     — 100% new_order/payment; writes_failed_during_failover KPI populated
# Combined rollup: results/failover_*/failover_kpi.csv and failover_comparison.txt
# Unplanned (pod_delete / mysqld_kill):
#   failure_detection_sec   — trigger → first connect_ok=0 (within FAILOVER_DETECT_WINDOW_SEC)
#   primary_election_sec    — first connect_ok=0 → new PRIMARY hostname + write_ok=1
#   total_failover_sec      — trigger → new PRIMARY hostname + write_ok=1 (includes detect)
# Planned (set_as_primary):
#   failure_detection_sec   — N/A
#   primary_election_sec    — write-path downtime (first write_ok=0 → new PRIMARY + write_ok=1)
#   total_failover_sec      — same write-path downtime (0 if never unhealthy but primary moved)
# FAILOVER_DETECT_WINDOW_SEC=60           # unplanned connect-fail accept window
# FAILOVER_PLANNED_DETECT_WINDOW_SEC=10   # planned write/connect outage accept window
# FAILOVER_DETECT_GUARD_SEC=0             # 0 = TTD is first connect_ok=0 at/after trigger epoch only
                                          # (set >0 only to absorb pre-trigger poll skew; can zero TTD on flaky VIP)
#   app_recovery_sec        — trigger → RTO (TPS ≥ 90% baseline for 30s stable)
#   transactions_failed_during_failover — excess err/s + reconn/s over pre-trigger baseline (TTD → RTO)
#   writes_failed_during_failover — monitor polls with connect_ok=1 and write_ok=0 (trigger → max(RTO, promote))
#   tps_dip_duration_sec    — seconds with TPS < 90% baseline (failure → recovery)
#   peak_latency_failover_ms, transactions_failed_during_failover, data_loss
#
# Sysbench reconnect through GR/failover errors (keep full list):
# FAILOVER_MYSQL_IGNORE_ERRORS=1053,2013,1290,3100,1205,1213,2006,2014,2003,2055,1047,1158,1159,1161,3011,4094
#
# Trigger control (same timeline either way):
# FAILOVER_TRIGGER_ENABLED=1       # 0 = skip all failover actions
# FAILOVER_POD_DELETE=1            # Advanced pod_delete method: 0 = no kubectl pod delete (control run)

# RTO analysis thresholds
# FAILOVER_RECOVERY_THRESHOLD=0.90   # 90% of baseline TPS = recovered
# FAILOVER_RECOVERY_STABLE_SEC=30    # consecutive seconds at threshold
# FAILOVER_OUTAGE_TPS_RATIO=0.05     # TPS below this = outage

# --- Short local smoke test (~4 min) — append to benchmark.conf ---
# FAILOVER_WARMUP_SEC=60
# FAILOVER_BASELINE_SEC=60
# FAILOVER_OBSERVE_SEC=120
# FAILOVER_EDITIONS=advanced
# SKIP_PREPARE=1
# TPCC_TABLES=1
# TPCC_SCALE=10
# FAILOVER_POD_DELETE=0              # step 1: control run (no pod delete)
# FAILOVER_POD_DELETE=1              # step 2: real failover test
# FAILOVER_MYSQL_IGNORE_ERRORS=1053,2013,1290,3100,1205,1213,2006,2014,2003,2055,1047,1158,1159,1161,3011,4094

# --- Standard Edition failover trigger ---
# Method: power_off | install_update | storage_resize | manual
FAILOVER_STANDARD_TRIGGER_METHOD=install_update

# Control panel cluster UUID (for install_update, storage_resize, events)
STANDARD_CLUSTER_UUID=

# Internal dbaas API (power_off primary node only — NOT control panel cluster UUID)
# DO_DBAAS_API_TOKEN=
# STANDARD_PRIMARY_NODE_UUID=
# STANDARD_DBAAS_POWER_URL=https://api.digitalocean.com/v2/dbaas/clusters/{node-uuid}/power

# Public DO API token (install_update, storage_resize, events)
# DIGITALOCEAN_TOKEN=

# For storage_resize fallback only:
# STANDARD_CLUSTER_SIZE_SLUG=db-s-4vcpu-8gb
# STANDARD_CLUSTER_STORAGE_MIB=204800
# STANDARD_CLUSTER_NUM_NODES=3   # see NUM_NODES / STANDARD_CLUSTER_NUM_NODES at top of file

# --- Advanced Edition failover trigger ---
# Method: pod_delete | mysqld_kill | mysqld_freeze | set_as_primary
#   pod_delete      — kubectl delete primary pod (default; unplanned)
#   mysqld_kill     — kubectl exec kill mysqld inside primary pod (process crash)
#   mysqld_freeze   — node cgroup freeze of mysql container (GR UNREACHABLE / expel path)
#   set_as_primary  — graceful planned primary replacement via group_replication_set_as_primary
FAILOVER_ADVANCED_TRIGGER_METHOD=pod_delete
# Optional 2nd arg to group_replication_set_as_primary(uuid[, timeout]): seconds to wait for
# ongoing transactions before forcing the switch (MySQL UDF). Default 1.
FAILOVER_SET_AS_PRIMARY_TIMEOUT_SEC=1
# Run unplanned then planned in one harness invocation (results under advanced/<method>/...).
# Leave unset to use only FAILOVER_ADVANCED_TRIGGER_METHOD above (no extra method subdir).
FAILOVER_TRIGGER_MATRIX="pod_delete set_as_primary"
FAILOVER_TRIGGER_MATRIX_DELAY_SEC=180
# Harness prepares kubeconfig + primary pod during baseline, re-resolves pod
# FAILOVER_TRIGGER_PREPARE_SEC seconds before trigger, then fires at trigger second.
# FAILOVER_TRIGGER_PREPARE_SEC=5
# Optional: pin which SECONDARY to promote for set_as_primary (else first SECONDARY found)
# ADVANCED_K8S_PROMOTE_POD_NAME=
# pod_delete: ungraceful kill (default): grace-period=0 --force
FAILOVER_POD_DELETE_FORCE=1
FAILOVER_POD_DELETE_GRACE_SEC=0
# pod_delete graceful delete instead: FAILOVER_POD_DELETE_FORCE=0 FAILOVER_POD_DELETE_GRACE_SEC=30
# mysqld_kill: SIGKILL mysqld in mysql container (default signal 9)
# FAILOVER_MYSQLD_KILL_SIGNAL=9
# mysqld_freeze: hold primary mysql cgroup frozen long enough for
#   ~5s GR detection + member_expel_timeout (+ buffer). Default 15s.
# FAILOVER_MYSQLD_FREEZE_SEC=25
# FAILOVER_MYSQLD_FREEZE_THAW=1
# FAILOVER_MYSQLD_FREEZE_HELPER_IMAGE=busybox:1.36
# ADVANCED_K8S_MYSQL_CONTAINER=mysql
ADVANCED_CLUSTER_UUID=

# Kubeconfig: use one of these (fill in when API details are available)
# ADVANCED_KUBECONFIG_PATH=/path/to/kubeconfig
# ADVANCED_KUBECONFIG_FETCH_URL=https://api.digitalocean.com/v2/dbaas/clusters/{uuid}/kubeconfig
# ADVANCED_KUBECONFIG_FETCH_TOKEN=
# ADVANCED_KUBECONFIG_FETCH_CMD='curl -sS -H "Authorization: Bearer $TOKEN" "https://..." > "$RESULTS_DIR/kubeconfig"'

ADVANCED_K8S_NAMESPACE=
# PerconaServerMySQL CR name (for HAProxy health-check patch)
# ADVANCED_PSMYSQL_CR_NAME=benchmark-failover2

# HAProxy backend health check (Advanced): maps to HA_SERVER_OPTIONS check inter N ms
# Operator default is often inter 10000ms rise 1 fall 2; tighter failover-friendly example:
# HAPROXY_HEALTH_CHECK_INTERVAL_SEC=2
# HAPROXY_HEALTH_CHECK_RISE=1
# HAPROXY_HEALTH_CHECK_FALL=1
# HAPROXY_APPLY_BEFORE_FAILOVER=1
# HAPROXY_APPLY_WAIT_SEC=90
#
# MySQL pod probes (one-time CR patch — persists until changed; relaxes GR RECOVERING kills):
# MYSQL_PROBE_APPLY_BEFORE_FAILOVER=0       # 1 = patch CR when harness starts (usually run script once instead)
# MYSQL_PROBE_APPLY_WAIT_SEC=120
# MYSQL_LIVENESS_INITIAL_DELAY_SEC=60
# MYSQL_LIVENESS_PERIOD_SEC=30
# MYSQL_LIVENESS_FAILURE_THRESHOLD=40       # ~20 min tolerance after initial delay
# MYSQL_READINESS_INITIAL_DELAY_SEC=60
# MYSQL_READINESS_PERIOD_SEC=10
# MYSQL_READINESS_FAILURE_THRESHOLD=60

# PMM client integration (Advanced, once per cluster — skipped if spec.pmm.enabled=true)
# PMM_APPLY_BEFORE_FAILOVER=0       # 1 = patch secrets + CR before first failover run
# PMM_REQUIRE_INTEGRATION=0         # 1 = abort if PMM not enabled and apply=0
# PMM_SERVER_HOST=                  # PMM server IP/hostname (spec.pmm.serverHost)
# PMM_SERVER_TOKEN=                 # pmmservertoken for <CR>-secrets and internal-<CR>
# PMM_CLIENT_IMAGE=percona/pmm-client:3.7.0
# PMM_ROLLOUT_TIMEOUT_SEC=300       # kubectl rollout status statefulset/<CR>-mysql

# ADVANCED_K8S_CONTEXT=
# ADVANCED_K8S_PRIMARY_POD_NAME=          # optional if auto-detect works
# ADVANCED_K8S_POD_LABEL_SELECTOR=        # e.g. mysql.percona.com/role=primary
# ADVANCED_K8S_CLUSTER_LABEL=app.kubernetes.io/instance=mysql
# ADVANCED_K8S_PRIMARY_ROLE_LABEL=role=primary

# Reuse TPC-C dataset settings from above; for failover-only runs:
# SKIP_PREPARE=1
# TPCC_TABLES=1
# TPCC_SCALE=50
